[Unit]
Description=Identify board connected as /dev/%I
After=dev-%i.device
BindsTo=dev-%i.device

[Service]
Type=oneshot
ExecStart=/opt/board-identify/.venv/bin/board-identify identify /dev/%I
# The leading dash keeps the unit out of the failed state when nothing was published.
ExecStop=-/opt/board-identify/.venv/bin/board-identify remove %I
RemainAfterExit=yes
# A probe may reset the target and retry the connection, so allow more than the
# probe timeout in board_identify.probes.espressif. A debug probe answers in a
# fraction of a second and never approaches this.
TimeoutStartSec=60
